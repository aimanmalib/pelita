# Host values for deploy/deploy.sh: the reverse proxy this site sits behind (traefik with a file provider).
# Copy to ~/.config/pelita/host.env (or set PELITA_HOST_ENV) and fill in. Kept out of the repository: they describe
# the host, not the project.
# Docker network shared with the proxy.
NETWORK=proxy
# Proxy container that reads route files, and the directory it watches.
PROXY_CONTAINER=traefik
PROXY_DYNAMIC_DIR=/traefik/dynamic
# traefik certificate resolver name.
CERT_RESOLVER=letsencrypt
