# Host values for deploy/deploy.sh and deploy/uptime.sh. Not secret. Change them here, not in the scripts.
DOMAIN=pelita.sasateguh.com
# Container name doubles as the host name on the shared proxy network: keep the project prefix.
CONTAINER=pelita-web
HOLDER=pelita-web-undur
IMAGE=pelita-web
# Base image pinned by digest (nginx stable, alpine). Upgrading = new digest here, then deploy.
BASE_IMAGE=nginx:stable-alpine@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949
NETWORK=coolify
CPUS=0.5
MEMORY=64m
PROXY_CONTAINER=coolify-proxy
PROXY_DYNAMIC_DIR=/traefik/dynamic
CERT_RESOLVER=letsencrypt
MIN_FREE_GB=20
# Uptime watch (cron PELITA-UPTIME): failures in a row before one warning.
UPTIME_FAILS_BEFORE_WARN=3
